// IdeaDock Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum IdeaStatus {
  PENDING
  RESEARCHING
  READY
  ERROR
}

enum ResearchCategory {
  MARKET_SIZE
  COMPETITORS
  TRENDS
  CUSTOMER_SEGMENTS
  RISKS
}

model Idea {
  id             String            @id @default(cuid())
  userId         String
  title          String
  rawText        String
  status         IdeaStatus        @default(PENDING)
  readinessScore Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sections       ResearchSection[]
}

model ResearchSection {
  id        String           @id @default(cuid())
  ideaId    String
  idea      Idea             @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  category  ResearchCategory
  summary   String
  score     Int              @default(0)
  sources   Json             @default("[]")
  createdAt DateTime         @default(now())

  @@unique([ideaId, category])
  @@index([ideaId])
}
